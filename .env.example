# Copy this file to .env and fill in values. Never commit .env (the repo is public).

# Postgres connection string (local Postgres, or Render's "External Database URL" for local dev)
DATABASE_URL=

# PayPal sandbox app credentials (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Same client ID, exposed to the browser for the PayPal JS checkout button
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Channel3 product search API key
CHANNEL3_API_KEY=

# The Elf's AI model (any OpenAI-compatible API). Defaults are Google Gemini's free tier:
#   key from https://aistudio.google.com  (Get API key)
LLM_API_KEY=
# Optional. Defaults: Gemini OpenAI-compatible endpoint + gemini-3.8-flash.
# For Groq instead: LLM_BASE_URL=https://api.groq.com/openai/v1 and a Groq model with tool calling.
LLM_BASE_URL=
LLM_MODEL=
# Optional: low | medium | high | none (defaults to "low" on Gemini, unset elsewhere)
LLM_REASONING_EFFORT=

# Passcode for the admin "reset demo data" action (pick any long random string)
ADMIN_PASSCODE=

# Gift payment holds: gifts are only held (authorized) at checkout and charged when the charity buys them.
# Unused holds are released after 72 hours. Optional: GIFT_HOLD_HOURS (1-72) to test with a shorter hold.
GIFT_HOLD_HOURS=
# Secret for the scheduled job that releases expired holds:
#   POST /api/cron/release-holds with header "Authorization: Bearer <CRON_SECRET>" (any long random string)
CRON_SECRET=

# Dev only: cheaper | pricier | soldout simulates the Buy re-check. Ignored in production.
BUY_CHECK_SIMULATE=
